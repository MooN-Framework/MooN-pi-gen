# Installed by stage6-moon/04-readonly-rootfs. Writable, non-persistent
# path on top of the read-only rootfs.
[Unit]
Description=Temporary Directory /tmp (MooN, always tmpfs since rootfs is read-only)

[Mount]
What=tmpfs
Where=/tmp
Type=tmpfs
Options=mode=1777,strictatime,nosuid,nodev,size=10%

[Install]
WantedBy=local-fs.target
