# Installed by stage6-moon/05-image-integrity. Checks the signed rootfs
# manifest before sysinit.target, gates moon-pkg-load.service.
[Unit]
Description=MooN: verify critical files against signed rootfs manifest
DefaultDependencies=no
After=local-fs.target
Before=moon-pkg-load.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/moon-integrity-check.sh

[Install]
WantedBy=sysinit.target
