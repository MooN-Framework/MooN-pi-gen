# Installed by stage6-moon/03-moon-package-service. Starts the MooN node
# from the verified payload in /opt/moon. Only runs if moon-pkg-load.service
# succeeded (/run/moon/package-loaded). Restart=no is intentional.
# Tracked by the rootfs integrity manifest, update it on a running node
# with tools/moon-deploy.sh --node-unit ... --signing-key ...
[Unit]
Description=MooN node process
After=moon-pkg-load.service network-online.target
Requires=moon-pkg-load.service
Wants=network-online.target
ConditionPathExists=/run/moon/package-loaded

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /opt/moon/logs
ExecStart=/opt/moon/bin/node --config /opt/moon/config/node.toml --log-dir /opt/moon/logs/
Restart=no
# Rootfs is read-only, all writable state for the node lives in tmpfs.
ProtectSystem=strict
ReadWritePaths=/opt/moon /run/moon

[Install]
WantedBy=multi-user.target
