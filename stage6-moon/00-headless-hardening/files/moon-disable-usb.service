# Installed by stage6-moon/00-headless-hardening. Runs once per boot and
# deauthorizes all USB root hubs (moon-disable-usb.sh).
[Unit]
Description=MooN: deauthorize all USB ports
DefaultDependencies=no
After=sysinit.target
Before=basic.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/moon-disable-usb.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
